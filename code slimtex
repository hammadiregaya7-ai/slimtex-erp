// ==================== RENDER FUNCTIONS ====================
function getStatusClass(s) {
  const map = { 'Active': 'active', 'Completed': 'completed', 'Passed': 'passed', 'Pending': 'pending', 'In Progress': 'in-progress', 'Cancelled': 'cancelled', 'Failed': 'failed', 'Running': 'active', 'Maintenance': 'pending', 'Down': 'failed', 'On Leave': 'pending', 'Low': 'low', 'Medium': 'medium', 'High': 'high' };
  return map[s] || 'pending';
}

function renderInventory() {
  const filter = document.getElementById('invFilter')?.value || 'all';
  const search = (document.getElementById('invSearch')?.value || '').toLowerCase();
  let data = inventory.filter(i => {
    if (filter !== 'all' && i.category !== filter) return false;
    if (search && !i.name.toLowerCase().includes(search) && !i.sku.toLowerCase().includes(search)) return false;
    return true;
  });
  const tbody = document.getElementById('inventoryTable');
  if (!tbody) return;
  tbody.innerHTML = data.map(i => {
    let status = 'In Stock', sc = 'active';
    if (i.qty === 0) { status = 'Out of Stock'; sc = 'failed'; }
    else if (i.qty < 100) { status = 'Low Stock'; sc = 'pending'; }
    return `<tr>
      <td><strong>${i.sku}</strong></td><td>${i.name}</td><td>${i.category}</td>
      <td>${i.qty.toLocaleString()}</td><td>${i.unit}</td><td>$${(i.qty * i.price).toLocaleString()}</td>
      <td><span class="status-badge ${sc}">${status}</span></td>
      <td><button class="btn btn-danger btn-sm" onclick="deleteInventory('${i.sku}')">Delete</button></td>
    </tr>`;
  }).join('');
  document.getElementById('invTotal').textContent = inventory.length.toLocaleString();
  document.getElementById('invInStock').textContent = inventory.filter(i => i.qty >= 100).length.toLocaleString();
  document.getElementById('invLow').textContent = inventory.filter(i => i.qty > 0 && i.qty < 100).length.toLocaleString();
  document.getElementById('invOut').textContent = inventory.filter(i => i.qty === 0).length.toLocaleString();
}

function renderOrders() {
  const filter = document.getElementById('ordFilter')?.value || 'all';
  const search = (document.getElementById('ordSearch')?.value || '').toLowerCase();
  let data = orders.filter(o => {
    if (filter !== 'all' && o.status !== filter) return false;
    if (search && !o.customer.toLowerCase().includes(search) && !o.id.toLowerCase().includes(search)) return false;
    return true;
  });
  const tbody = document.getElementById('ordersTable');
  if (!tbody) return;
  tbody.innerHTML = data.map(o => `<tr>
    <td><strong>${o.id}</strong></td><td>${o.customer}</td><td>${o.product}</td>
    <td>${o.qty.toLocaleString()}</td><td>$${o.amount.toLocaleString()}</td><td>${o.date}</td>
    <td><span class="status-badge ${getStatusClass(o.status)}">${o.status}</span></td>
    <td>
      ${o.status === 'Pending' ? `<button class="btn btn-success btn-sm" onclick="updateOrderStatus('${o.id}','In Progress')">Start</button>` : ''}
      ${o.status === 'In Progress' ? `<button class="btn btn-primary btn-sm" onclick="updateOrderStatus('${o.id}','Completed')">Complete</button>` : ''}
      <button class="btn btn-danger btn-sm" onclick="deleteOrder('${o.id}')">Delete</button>
    </td>
  </tr>`).join('');
  document.getElementById('ordTotal').textContent = orders.length;
  document.getElementById('ordPending').textContent = orders.filter(o => o.status === 'Pending').length;
  document.getElementById('ordCompleted').textContent = orders.filter(o => o.status === 'Completed').length;
}

