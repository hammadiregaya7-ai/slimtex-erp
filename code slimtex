      <td><strong>${p.id}</strong></td><td>${p.product}</td><td>${p.machine}</td>
      <td>${p.qty.toLocaleString()}</td>
      <td><div class="progress-bar" style="width:120px"><div class="progress-fill ${color}" style="width:${p.progress}%"></div></div><small>${p.progress}%</small></td>
      <td><span class="status-badge ${getStatusClass(p.status)}">${p.status}</span></td>
      <td>
        ${p.status === 'In Progress' ? `<button class="btn btn-primary btn-sm" onclick="updateProduction('${p.id}')">Update</button>` : ''}
        <button class="btn btn-danger btn-sm" onclick="deleteProduction('${p.id}')">Delete</button>
      </td>
    </tr>`;
  }).join('');
  document.getElementById('prodActive').textContent = production.filter(p => p.status === 'In Progress').length;
  document.getElementById('prodCompleted').textContent = production.filter(p => p.status === 'Completed').length;
}

function renderQC() {
  const tbody = document.getElementById('qcTable');
  if (!tbody) return;
  tbody.innerHTML = qcRecords.map(q => `<tr>
    <td><strong>${q.id}</strong></td><td>${q.batch}</td><td>${q.product}</td>
    <td>${q.inspector}</td><td>${q.defects}</td>
    <td><span class="status-badge ${getStatusClass(q.result)}">${q.result}</span></td>
    <td>${q.date}</td>
    <td><button class="btn btn-danger btn-sm" onclick="deleteQC('${q.id}')">Delete</button></td>
  </tr>`).join('');
  document.getElementById('qcPassed').textContent = ((qcRecords.filter(q => q.result === 'Passed').length / qcRecords.length) * 100).toFixed(1) + '%';
  document.getElementById('qcInspections').textContent = qcRecords.length;
  document.getElementById('qcFailed').textContent = qcRecords.filter(q => q.result === 'Failed').length;
  document.getElementById('qcPending').textContent = qcRecords.filter(q => q.result === 'Pending').length;
}

function renderEmployees() {
  const filter = document.getElementById('empDeptFilter')?.value || 'all';
  const search = (document.getElementById('empSearch')?.value || '').toLowerCase();
  let data = employees.filter(e => {
    if (filter !== 'all' && e.dept !== filter) return false;
    if (search && !e.name.toLowerCase().includes(search)) return false;
    return true;
  });
  const tbody = document.getElementById('employeesTable');
  if (!tbody) return;
  tbody.innerHTML = data.map(e => `<tr>
    <td><strong>${e.id}</strong></td><td>${e.name}</td><td>${e.dept}</td>
    <td>${e.position}</td><td>${e.phone}</td>
    <td><span class="status-badge ${getStatusClass(e.status)}">${e.status}</span></td>
    <td><button class="btn btn-danger btn-sm" onclick="deleteEmployee('${e.id}')">Delete</button></td>
  </tr>`).join('');
  document.getElementById('empTotal').textContent = employees.length;
  document.getElementById('empActive').textContent = employees.filter(e => e.status === 'Active').length;
}

function renderMachines() {
  const tbody = document.getElementById('machinesTable');
  if (!tbody) return;
  tbody.innerHTML = machines.map(m => `<tr>
    <td><strong>${m.id}</strong></td><td>${m.name}</td><td>${m.type}</td><td>${m.dept}</td>
    <td>${m.uptime}%</td><td>${m.lastMaint}</td>
    <td><span class="status-badge ${getStatusClass(m.status)}">${m.status}</span></td>
    <td><button class="btn btn-danger btn-sm" onclick="deleteMachine('${m.id}')">Delete</button></td>
  </tr>`).join('');
}

