// ==================== CRUD OPERATIONS ====================
function addInventory() {
  const item = {
    sku: document.getElementById('invSku').value.trim(),
    name: document.getElementById('invName').value.trim(),
    category: document.getElementById('invCategory').value,
    qty: parseInt(document.getElementById('invQty').value) || 0,
    unit: document.getElementById('invUnit').value,
    price: parseFloat(document.getElementById('invPrice').value) || 0
  };
  if (!item.sku || !item.name) { showToast('SKU and Name are required', 'error'); return; }
  inventory.push(item); DB.set('inventory', inventory);
  renderInventory(); closeModal('inventoryModal'); showToast('Inventory item added!');
  ['invSku','invName','invQty','invPrice'].forEach(id => document.getElementById(id).value = '');
}

function deleteInventory(sku) {
  if (!confirm('Delete this item?')) return;
  inventory = inventory.filter(i => i.sku !== sku); DB.set('inventory', inventory);
  renderInventory(); showToast('Item deleted', 'warning');
}

function addOrder() {
  const order = {
    id: 'ORD-2024-' + String(orders.length + 1).padStart(3, '0'),
    customer: document.getElementById('ordCustomer').value.trim(),
    product: document.getElementById('ordProduct').value,
    qty: parseInt(document.getElementById('ordQty').value) || 0,
    amount: parseFloat(document.getElementById('ordAmount').value) || 0,
    date: new Date().toISOString().split('T')[0],
    status: 'Pending'
  };
  if (!order.customer) { showToast('Customer name is required', 'error'); return; }
  orders.push(order); DB.set('orders', orders);
  renderOrders(); renderRecentOrders(); closeModal('orderModal'); showToast('Order created!');
  ['ordCustomer','ordQty','ordAmount','ordNotes'].forEach(id => document.getElementById(id).value = '');
}

function updateOrderStatus(id, status) {
  const o = orders.find(x => x.id === id);
  if (o) { o.status = status; DB.set('orders', orders); renderOrders(); renderRecentOrders(); showToast('Order updated!'); }
}

function deleteOrder(id) {
  if (!confirm('Delete this order?')) return;
  orders = orders.filter(o => o.id !== id); DB.set('orders', orders);
  renderOrders(); renderRecentOrders(); showToast('Order deleted', 'warning');
}

function addProduction() {
  const batch = {
    id: 'BATCH-' + String(production.length + 1).padStart(3, '0'),
    product: document.getElementById('prodProduct').value,
    machine: document.getElementById('prodMachine').value,
    qty: parseInt(document.getElementById('prodQty').value) || 0,
    progress: 0, status: 'In Progress'
  };
  if (!batch.qty) { showToast('Quantity is required', 'error'); return; }
  production.push(batch); DB.set('production', production);
  renderProduction(); closeModal('productionModal'); showToast('Production batch started!');
  document.getElementById('prodQty').value = '';
}

function updateProduction(id) {
  const p = production.find(x => x.id === id);
  if (p) {
    p.progress = Math.min(100, p.progress + Math.floor(Math.random() * 20) + 10);
    if (p.progress >= 100) { p.progress = 100; p.status = 'Completed'; }
    DB.set('production', production); renderProduction(); showToast('Progress updated!');
  }
}

function deleteProduction(id) {
  if (!confirm('Delete this batch?')) return;
  production = production.filter(p => p.id !== id); DB.set('production', production);
  renderProduction(); showToast('Batch deleted', 'warning');
}

function addEmployee() {
  const emp = {
    id: 'EMP-' + String(employees.length + 1).padStart(3, '0'),
    name: document.getElementById('empName').value.trim(),
    dept: document.getElementById('empDept').value,
