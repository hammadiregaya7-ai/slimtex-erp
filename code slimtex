// ==================== DATA EXPORT/IMPORT ====================
function exportData() {
  const data = { inventory, orders, production, qcRecords, employees, machines, exportDate: new Date().toISOString() };
  const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = 'textile_erp_backup_' + new Date().toISOString().split('T')[0] + '.json';
  a.click();
  showToast('Data exported successfully!');
}

function importData(event) {
  const file = event.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = e => {
    try {
      const data = JSON.parse(e.target.result);
      if (data.inventory) { inventory = data.inventory; DB.set('inventory', inventory); }
      if (data.orders) { orders = data.orders; DB.set('orders', orders); }
      if (data.production) { production = data.production; DB.set('production', production); }
      if (data.qcRecords) { qcRecords = data.qcRecords; DB.set('qc', qcRecords); }
      if (data.employees) { employees = data.employees; DB.set('employees', employees); }
      if (data.machines) { machines = data.machines; DB.set('machines', machines); }
      renderAll();
      showToast('Data imported successfully!');
    } catch { showToast('Invalid file format', 'error'); }
  };
  reader.readAsText(file);
}

function showNotifications() {
  showToast('You have 7 unread notifications', 'warning');
}

