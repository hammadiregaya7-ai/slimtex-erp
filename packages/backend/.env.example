# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/slimtex?schema=public"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-min-32-chars"
JWT_EXPIRATION="7d"

# Frontend URL (CORS)
FRONTEND_URL="http://localhost:3000"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# Server Configuration
PORT="3001"
NODE_ENV="development"

# Rate Limiting
THROTTLE_TTL="60000"
THROTTLE_LIMIT="100"

# ETA E-Invoicing (Tunisia)
ETA_API_URL="https://api-eta.finances.gov.tn"
ETA_CLIENT_ID="your-client-id"
ETA_CLIENT_SECRET="your-client-secret"

# Webhook Configuration
WEBHOOK_SECRET="your-webhook-secret-key"

# Email Configuration (for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# File Upload
MAX_FILE_SIZE="10485760"
UPLOAD_PATH="./uploads"
