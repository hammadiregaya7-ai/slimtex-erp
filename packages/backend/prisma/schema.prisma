generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema", "postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// MULTI-TENANCY BASE MIXIN
// Every core table must have tenant_id for Row-Level Security isolation
// ============================================================================

/// Organization/Tenant model - represents a company subscribing to Slimtex ERP
model Tenant {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique // For subdomain routing
  taxId       String?  // Tunisian Tax ID (Matricule Fiscale)
  address     Json?   // Localized: { ar: "...", en: "..." }
  phone       String?
  email       String?
  logoUrl     String?
  currency    String   @default("TND") // Tunisian Dinar
  language    String   @default("ar") // Default language: ar or en
  timezone    String   @default("Africa/Tunis")
  etaEnabled  Boolean  @default(false) // Electronic Tax Authority integration
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  users       User[]
  warehouses  Warehouse[]
  products    Product[]
  categories  Category[]
  accounts    Account[]
  journals    JournalEntry[]
  invoices    Invoice[]
  quotes      Quote[]
  orders      PurchaseOrder[]
  payments    Payment[]
  stockLevels StockLevel[]
  stockMovements StockMovement[]
  journalEntryLines JournalEntryLine[]
  quoteItems  QuoteItem[]
  invoiceItems InvoiceItem[]
  purchaseOrderItems PurchaseOrderItem[]
  expenseCategories ExpenseCategory[]
  expenses Expense[]
  syncLogs    SyncLog[]
  webhookSubscriptions WebhookSubscription[]

  @@index([slug])
  @@map("tenants")
}

// ============================================================================
// IAM - Identity & Access Management
// ============================================================================

model User {
  id          String   @id @default(uuid())
  tenantId    String
  email       String
  passwordHash String
  firstName   String
  lastName    String
  fullNameAr  String?  // Arabic full name
  fullNameEn  String?  // English full name
  avatarUrl   String?
  phone       String?
  role        Role     @default(USER)
  permissions String[] // Granular permissions array
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

enum Role {
  OWNER       // Full access
  ADMIN       // Administrative access
  ACCOUNTANT  // Accounting & financial reports
  MANAGER     // Inventory & sales management
  WAREHOUSE   // Warehouse operations only
  SALES       // Field sales only
  USER        // Basic read-only access
}

// ============================================================================
// PRODUCT & INVENTORY MODULE
// ============================================================================

model Category {
  id          String   @id @default(uuid())
  tenantId    String
  parentId    String?  // For nested categories
  name        Json    // Localized: { ar: "...", en: "..." }
  description Json?   // Localized
  code        String?  // Internal category code
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String    @id @default(uuid())
  tenantId        String
  categoryId      String?
  sku             String
  barcode         String?   // EAN-13 or custom barcode
  name            Json     // Localized: { ar: "...", en: "..." }
  description     Json?    // Localized
  unit            String    @default("PIECE") // UNIT, KG, METER, LITER, etc.
  costPrice       Decimal   @default(0) @db.Decimal(15, 4)
  salePrice       Decimal   @default(0) @db.Decimal(15, 4)
  taxRate         Decimal   @default(19) @db.Decimal(5, 2) // Tunisia VAT: 7%, 13%, 19%
  minStockLevel   Int       @default(0)
  maxStockLevel   Int?
  weight          Decimal?  @db.Decimal(10, 3)
  dimensions      Json?    // { length, width, height }
  images          String[]  // Array of image URLs
  isActive        Boolean   @default(true)
  isTrackable     Boolean   @default(true) // Track stock movements
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  category        Category? @relation(fields: [categoryId], references: [id])
  stockLevels     StockLevel[]
  stockMovements  StockMovement[]
  invoiceItems    InvoiceItem[]
  quoteItems      QuoteItem[]
  orderItems      PurchaseOrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([categoryId])
  @@map("products")
}

model Warehouse {
  id          String   @id @default(uuid())
  tenantId    String
  name        Json    // Localized
  code        String
  address     Json?   // Localized
  phone       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  stockLevels StockLevel[]
  movements   StockMovement[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("warehouses")
}

model StockLevel {
  id          String   @id @default(uuid())
  tenantId    String
  productId   String
  warehouseId String
  quantity    Int      @default(0)
  reservedQty Int      @default(0) // Reserved for pending orders
  lastCountedAt DateTime?
  updatedAt   DateTime @updatedAt

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([tenantId, productId, warehouseId])
  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@map("stock_levels")
}

model StockMovement {
  id          String           @id @default(uuid())
  tenantId    String
  productId   String
  warehouseId String
  type        StockMovementType
  quantity    Int              // Positive for IN, negative for OUT
  referenceId String?          // Reference to Invoice, Order, etc.
  referenceType String?        // INVOICE, ORDER, ADJUSTMENT, TRANSFER
  notes       Json?           // Localized notes
  performedBy String           // User ID who performed the movement
  createdAt   DateTime         @default(now())

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([tenantId])
  @@index([productId])
  @@index([warehouseId])
  @@index([referenceId])
  @@index([createdAt])
  @@map("stock_movements")
}

enum StockMovementType {
  PURCHASE_RECEIPT
  SALE_SHIPMENT
  RETURN_IN
  RETURN_OUT
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  PRODUCTION_CONSUME
  PRODUCTION_PRODUCE
}

// ============================================================================
// FINANCIAL CORE - Double-Entry Accounting
// ============================================================================

model Account {
  id          String       @id @default(uuid())
  tenantId    String
  parentId    String?      // For account hierarchy
  code        String       // Account code (e.g., "1100", "4110")
  name        Json        // Localized: { ar: "...", en: "..." }
  description Json?       // Localized
  type        AccountType
  currency    String       @default("TND")
  isActive    Boolean      @default(true)
  isSystem    Boolean      @default(false) // System accounts cannot be deleted
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  parent      Account?   @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    Account[]  @relation("AccountHierarchy")
  entries     JournalEntryLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("accounts")
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

model JournalEntry {
  id          String   @id @default(uuid())
  tenantId    String
  date        DateTime
  number      String   // Sequential journal entry number
  description Json    // Localized
  reference   String?  // External reference (Invoice #, etc.)
  source      JournalSource
  isPosted    Boolean  @default(false)
  totalDebit  Decimal  @db.Decimal(15, 4)
  totalCredit Decimal  @db.Decimal(15, 4)
  createdBy   String   // User ID
  postedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant  Tenant             @relation(fields: [tenantId], references: [id])
  lines   JournalEntryLine[]
  expenses Expense[]

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([date])
  @@map("journal_entries")
}

enum JournalSource {
  MANUAL
  INVOICE
  PAYMENT
  PURCHASE_ORDER
  QUOTE
  ADJUSTMENT
  SYSTEM
}

model JournalEntryLine {
  id              String  @id @default(uuid())
  tenantId        String
  journalEntryId  String
  accountId       String
  debit           Decimal @default(0) @db.Decimal(15, 4)
  credit          Decimal @default(0) @db.Decimal(15, 4)
  description     Json?  // Localized line description
  reference       String? // Optional reference

  // Relations
  tenant       Tenant         @relation(fields: [tenantId], references: [id])
  journalEntry JournalEntry   @relation(fields: [journalEntryId], references: [id])
  account      Account        @relation(fields: [accountId], references: [id])

  @@index([tenantId])
  @@index([journalEntryId])
  @@index([accountId])
  @@map("journal_entry_lines")
}

// ============================================================================
// SALES MODULE
// ============================================================================

model Quote {
  id          String        @id @default(uuid())
  tenantId    String
  number      String        // Quote number
  customerId  String?       // Optional customer (can be walk-in)
  customerName Json?       // Localized customer name if no account
  customerEmail String?
  customerPhone String?
  status      QuoteStatus   @default(DRAFT)
  issueDate   DateTime      @default(now())
  expiryDate  DateTime?
  notes       Json?        // Localized terms & conditions
  items       QuoteItem[]
  subtotal    Decimal       @db.Decimal(15, 4)
  taxTotal    Decimal       @db.Decimal(15, 4)
  total       Decimal       @db.Decimal(15, 4)
  convertedToInvoiceId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([status])
  @@map("quotes")
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model QuoteItem {
  id        String  @id @default(uuid())
  tenantId  String
  quoteId   String
  productId String?
  description Json // Localized item description
  quantity  Decimal @db.Decimal(15, 4)
  unitPrice Decimal @db.Decimal(15, 4)
  taxRate   Decimal @default(19) @db.Decimal(5, 2)
  discount  Decimal @default(0) @db.Decimal(15, 4)
  total     Decimal @db.Decimal(15, 4)

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  quote   Quote   @relation(fields: [quoteId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_items")
}

model Invoice {
  id          String        @id @default(uuid())
  tenantId    String
  number      String        // Invoice number (sequential per tenant)
  customerId  String?
  customerName Json?       // Localized
  customerEmail String?
  customerPhone String?
  customerTaxId String?     // Customer VAT/Tax ID
  customerAddress Json?    // Localized address
  status      InvoiceStatus @default(DRAFT)
  type        InvoiceType   @default(STANDARD)
  issueDate   DateTime      @default(now())
  dueDate     DateTime?
  etaInvoiceId String?      // Tunisian ETA invoice identifier
  etaReceiptId String?      // Tunisian ETA receipt identifier
  etaStatus   EtaStatus     @default(NOT_REQUIRED)
  notes       Json?        // Localized
  reference   String?      // Customer PO reference
  items       InvoiceItem[]
  payments    Payment[]
  subtotal    Decimal       @db.Decimal(15, 4)
  taxTotal    Decimal       @db.Decimal(15, 4)
  total       Decimal       @db.Decimal(15, 4)
  paidAmount  Decimal       @default(0) @db.Decimal(15, 4)
  journalEntryId String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@index([status])
  @@index([issueDate])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum InvoiceType {
  STANDARD
  PROFORMA
  CREDIT_NOTE
  DEBIT_NOTE
  RECEIPT // Simplified invoice for retail
}

enum EtaStatus {
  NOT_REQUIRED
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

model InvoiceItem {
  id        String  @id @default(uuid())
  tenantId  String
  invoiceId String
  productId String?
  description Json // Localized
  quantity  Decimal @db.Decimal(15, 4)
  unitPrice Decimal @db.Decimal(15, 4)
  taxRate   Decimal @default(19) @db.Decimal(5, 2)
  discount  Decimal @default(0) @db.Decimal(15, 4)
  total     Decimal @db.Decimal(15, 4)

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  product Product? @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

// ============================================================================
// PURCHASING MODULE
// ============================================================================

model PurchaseOrder {
  id          String        @id @default(uuid())
  tenantId    String
  number      String
  supplierId  String?
  supplierName Json?       // Localized
  supplierEmail String?
  supplierPhone String?
  status      PurchaseOrderStatus @default(DRAFT)
  orderDate   DateTime      @default(now())
  expectedDate DateTime?
  notes       Json?
  items       PurchaseOrderItem[]
  subtotal    Decimal       @db.Decimal(15, 4)
  taxTotal    Decimal       @db.Decimal(15, 4)
  total       Decimal       @db.Decimal(15, 4)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, number])
  @@index([tenantId])
  @@map("purchase_orders")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrderItem {
  id        String  @id @default(uuid())
  tenantId  String
  orderId   String
  productId String?
  description Json
  quantity  Decimal @db.Decimal(15, 4)
  unitPrice Decimal @db.Decimal(15, 4)
  taxRate   Decimal @default(19) @db.Decimal(5, 2)
  total     Decimal @db.Decimal(15, 4)
  receivedQty Decimal @default(0) @db.Decimal(15, 4)

  // Relations
  tenant  Tenant        @relation(fields: [tenantId], references: [id])
  order   PurchaseOrder @relation(fields: [orderId], references: [id])
  product Product?      @relation(fields: [productId], references: [id])

  @@index([tenantId])
  @@index([orderId])
  @@map("purchase_order_items")
}

// ============================================================================
// PAYMENTS MODULE
// ============================================================================

model Payment {
  id          String      @id @default(uuid())
  tenantId    String
  invoiceId   String?
  amount      Decimal     @db.Decimal(15, 4)
  method      PaymentMethod
  reference   String?     // Check number, transaction ID, etc.
  notes       Json?      // Localized
  paymentDate DateTime    @default(now())
  journalEntryId String?
  createdAt   DateTime    @default(now())

  // Relations
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payments")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHECK
  CARD
  MOBILE_MONEY
  CREDIT
}

// ============================================================================
// OFFLINE SYNC MODULE (For Mobile App)
// ============================================================================

model SyncLog {
  id          String   @id @default(uuid())
  tenantId    String
  deviceId    String   // Mobile device identifier
  userId      String
  entityType  String   // INVOICE, STOCK_MOVEMENT, etc.
  entityId    String?
  action      SyncAction
  payload     Json    // The synced data
  timestamp   DateTime @default(now())
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([deviceId])
  @@index([userId])
  @@index([timestamp])
  @@index([processed])
  @@map("sync_logs")
}

enum SyncAction {
  CREATE
  UPDATE
  DELETE
  SYNC_BATCH
}

// ============================================================================
// WEBHOOK & INTEGRATION MODULE
// ============================================================================

model WebhookSubscription {
  id          String   @id @default(uuid())
  tenantId    String
  event       WebhookEvent
  url         String
  secret      String   // For HMAC signature verification
  isActive    Boolean  @default(true)
  headers     Json?   // Custom headers
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([event])
  @@map("webhook_subscriptions")
}

enum WebhookEvent {
  INVOICE_CREATED
  INVOICE_SENT
  INVOICE_PAID
  PAYMENT_RECEIVED
  STOCK_LOW
  ORDER_CREATED
  QUOTE_ACCEPTED
  ETA_SUBMITTED
  ETA_ACCEPTED
}

model WebhookDelivery {
  id              String   @id @default(uuid())
  subscriptionId  String
  eventType       WebhookEvent
  payload         Json
  status          WebhookStatus @default(PENDING)
  attempts        Int      @default(0)
  responseCode    Int?
  responseBody    String?
  nextRetryAt     DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime @default(now())

  @@index([subscriptionId])
  @@index([status])
  @@map("webhook_deliveries")
}

enum WebhookStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ============================================================================
// EXPENSE TRACKING MODULE
// ============================================================================

model ExpenseCategory {
  id          String   @id @default(uuid())
  tenantId    String
  parentId    String?  // For nested categories
  name        Json    // Localized: { ar: "...", en: "..." }
  code        String?  // Internal category code
  description Json?   // Localized description
  color       String?  // UI color for categorization
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  parent      ExpenseCategory? @relation("ExpenseCategoryHierarchy", fields: [parentId], references: [id])
  children    ExpenseCategory[] @relation("ExpenseCategoryHierarchy")
  expenses    Expense[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([parentId])
  @@map("expense_categories")
}

model Expense {
  id              String        @id @default(uuid())
  tenantId        String
  categoryId      String
  date            DateTime      @default(now())
  amount          Decimal       @db.Decimal(15, 4)
  taxRate         Decimal       @default(0) @db.Decimal(5, 2)
  taxAmount       Decimal       @default(0) @db.Decimal(15, 4)
  total           Decimal       @db.Decimal(15, 4)
  vendorName      String?       // Vendor/supplier name
  vendorTaxId     String?       // Vendor tax ID
  invoiceNumber   String?       // Vendor invoice reference
  paymentMethod   PaymentMethod @default(CASH)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentDate     DateTime?
  notes           Json?        // Localized notes
  attachments     String[]     // Array of receipt image URLs
  billableToCustomerId String?  // If expense is billable to a customer
  projectId       String?      // Link to project/job (future feature)
  journalEntryId  String?      // Linked accounting entry
  createdBy       String       // User ID
  approvedBy      String?      // User ID who approved
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  tenant          Tenant        @relation(fields: [tenantId], references: [id])
  category        ExpenseCategory @relation(fields: [categoryId], references: [id])
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])

  @@index([tenantId])
  @@index([categoryId])
  @@index([date])
  @@index([paymentStatus])
  @@index([createdBy])
  @@map("expenses")
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}
